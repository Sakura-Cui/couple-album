# Copy to .env only on the target server. Never commit credentials.
SAKURA_VERSION=1.2.26
SAKURA_DATA_DIR=/opt/sakura-romance/data
SAKURA_BACKUP_DIR=/opt/sakura-romance/backups
SAKURA_TLS_DIR=/opt/sakura-romance/tls
# Start locally bound. Public exposure requires confirmed certificate and port access.
SAKURA_BIND_IP=127.0.0.1
SAKURA_HTTPS_PORT=9443
SAKURA_STORAGE=local
# 8 GiB media quota includes reserved uploads; retain 12 GiB free system disk.
# Confirm these limits against actual server capacity before deploying.
SAKURA_QUOTA_BYTES=8589934592
SAKURA_STAGING_BYTES=4294967296
SAKURA_RESERVE_BYTES=12884901888
SAKURA_MAX_FILE_BYTES=2147483648

# Optional: device ID allowed to import its legacy local signature once.
# Find the device ID with python -m sakura.admin devices; do not use a device token.
SAKURA_SIGNATURE_SOURCE_DEVICE_ID=

# Optional message sender and push credentials (set on server only).
SAKURA_NOTIFY_KEY=
VIVO_APP_ID=
VIVO_APP_KEY=
VIVO_APP_SECRET=
VIVO_PUSH_MODE=1
